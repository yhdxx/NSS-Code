{
  "_comment": "myCodingAgent 首次启动会把本模板复制为 `~/.mycodingagent/mcp.json`。项目级配置可放在当前工作目录的 `.mycodingagent/mcp.json`。JSON 不支持注释，本模板用 `_comment` 字段写说明；loader 会忽略这些字段。",
  "servers": {
    "_comment": "servers 下每个对象名就是 MCP Server 名称；同名 server 在后加载的配置中会覆盖前者。",
    "github": {
      "disabled": true,
      "_comment": "GitHub 官方 MCP Server。启用前把 disabled 改为 false，并在启动 myAgent 的 shell 中 export GITHUB_PERSONAL_ACCESS_TOKEN。Runtime 会把它放入会话私有网络。",
      "transport": "stdio",
      "sandbox": true,
      "image": "ghcr.io/github/github-mcp-server",
      "image_entrypoint": true,
      "args": [],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "",
        "GITHUB_TOOLSETS": "repos,issues,pull_requests"
      },
      "network": true,
      "workspace_access": "none",
      "description": "GitHub 仓库、Issue、PR 和代码搜索操作",
      "tags": ["github", "git", "repo"],
      "aliases": ["gh"],
      "keywords": ["GitHub", "代码仓库", "PR", "issue"],
      "startup_timeout": 30,
      "call_timeout": 60,
      "permissions": {
        "_comment": "只读工具不会询问；写入、危险或未知工具会触发审批。工具名必须与 server 暴露的 MCP tool 名一致。",
        "read_tools": ["search_repositories", "get_file_contents"],
        "write_tools": ["create_issue", "create_pull_request"],
        "dangerous_tools": ["delete_file", "merge_pull_request"],
        "readonly_by_default": false
      }
    },
    "filesystem": {
      "disabled": true,
      "_comment": "需要访问当前工作区文件的 stdio server 示例。workspace_access 可选 none/read/write。",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/workspace"],
      "sandbox": true,
      "workspace_access": "read",
      "network": false,
      "description": "在 Docker 沙箱中读取工作区文件",
      "tags": ["filesystem", "workspace", "file"],
      "permissions": {
        "readonly_by_default": true
      }
    },
    "playwright": {
      "disabled": false,
      "_comment": "Microsoft Playwright MCP，默认启用并在启动时加载为直接 browser_* 工具。Docker 首次自动拉取镜像，后续复用本地缓存；bash scripts/install.sh --with-web-tools 可预拉取 Playwright 和 SearXNG 镜像。",
      "transport": "stdio",
      "sandbox": true,
      "image": "mcr.microsoft.com/playwright/mcp",
      "image_entrypoint": true,
      "auto_start": true,
      "args": [
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--no-sandbox"
      ],
      "network": true,
      "workspace_access": "none",
      "init": true,
      "shm_size": "1g",
      "cpus": "2",
      "memory": "2g",
      "pids_limit": "512",
      "container_user": "image",
      "description": "使用 Headless Chromium 执行动态网页交互、截图和本地 UI 验证",
      "tags": ["playwright", "browser", "chromium", "web", "screenshot"],
      "aliases": ["browser"],
      "keywords": ["网页", "浏览器", "动态页面", "截图", "UI 测试"],
      "startup_timeout": 60,
      "call_timeout": 120,
      "permissions": {
        "read_tools": [
          "browser_navigate",
          "browser_snapshot",
          "browser_take_screenshot",
          "browser_console_messages",
          "browser_network_requests",
          "browser_tabs"
        ],
        "write_tools": [
          "browser_click",
          "browser_type",
          "browser_fill_form",
          "browser_press_key",
          "browser_select_option"
        ],
        "dangerous_tools": [
          "browser_evaluate",
          "browser_file_upload",
          "browser_install"
        ],
        "readonly_by_default": false
      }
    },
    "remote-http": {
      "disabled": true,
      "_comment": "Streamable HTTP MCP 示例。把 url 和 Authorization 替换为远程 MCP Server 的真实地址和密钥。",
      "transport": "streamable_http",
      "url": "https://example.com/mcp",
      "headers": {
        "Authorization": "Bearer 请替换为真实 token"
      },
      "description": "远程 HTTP MCP Server",
      "tags": ["remote", "http", "mcp"],
      "startup_timeout": 20,
      "call_timeout": 60
    }
  }
}
